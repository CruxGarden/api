# Application Configuration
NODE_ENV=development
PORT=3000
HOSTNAME=127.0.0.1
BASE_URL=http://localhost:3000
LOG_LEVEL=debug

# Nursery Mode (Optional)
# When set to 'true', disables authentication for demo/trial environments
# Unauthenticated requests automatically use the seeded Keeper account
# WARNING: Only enable in demo environments, never in production
# NURSERY_MODE=true

# CORS (Optional)
# Exact Garden UI origin for local development or self-hosting. Published pages
# use scoped auth and registered publishing origins. '*' permits CORS reads,
# but never grants account-login or parent-handshake trust to arbitrary pages.
# In production on crux.garden, leave unset.
CORS_ORIGIN=http://localhost:8080

# Security & Authentication (REQUIRED)
# Must be at least 32 characters
JWT_SECRET=<jwt_secret_min_32_characters>
# Optional: salts the per-day visitor tokens derived from CloudFront logs (falls back to JWT_SECRET)
# USAGE_VISITOR_SALT=

# Database (REQUIRED)
# PostgreSQL connection URL
DATABASE_URL=postgresql://cruxgarden:cruxgarden_dev_password@127.0.0.1:5432/cruxgarden

# Database Connection Pool (Optional)
# Minimum connections in pool (default: 2)
DB_POOL_MIN=2
# Maximum connections in pool (default: 10)
DB_POOL_MAX=10
# Idle connection timeout in ms (default: 30000)
DB_POOL_IDLE_TIMEOUT=30000
# Connection acquire timeout in ms (default: 60000)
DB_POOL_ACQUIRE_TIMEOUT=60000

# Redis (REQUIRED)
# Redis connection URL for caching and sessions
REDIS_URL=redis://localhost:6379

# Rate Limiting (Optional)
# Time window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_TTL=60000
# Max requests per time window (default: 100)
RATE_LIMIT_MAX=100
# Crux Store writes one signed-in account may make per minute (default: 60).
# Every store write needs an account, so the limit is per account, not per IP.
STORE_WRITES_PER_MINUTE_PER_ACCOUNT=60
# Proxies in front of the API (Express 'trust proxy': a hop count such as 1, or
# 'loopback' etc.). REQUIRED behind a load balancer: without it every visitor
# shares the balancer's address and the per-IP limits below throttle everyone at once.
# TRUST_PROXY=1
# Sign-in routes, per IP per minute (defaults shown). Independently, one email
# gets at most 5 codes per 15 minutes and 5 wrong codes before a new code is needed.
# AUTH_CODE_PER_MINUTE_PER_IP=5
# AUTH_LOGIN_PER_MINUTE_PER_IP=10
# AUTH_TOKEN_PER_MINUTE_PER_IP=30

# AWS Configuration (REQUIRED)
AWS_ACCESS_KEY_ID=<aws_access_key_id>
AWS_SECRET_ACCESS_KEY=<aws_secret_access_key>
AWS_REGION=<aws_region>
# AWS SES (Simple Email Service)
AWS_SES_FROM_EMAIL=noreply@yourdomain.com
# AWS S3 (Simple Storage Service)
AWS_S3_ARTIFACTS_BUCKET=artifacts.crux.garden
# S3 bucket for cloud sync (garden + crux backups)
AWS_S3_SYNC_BUCKET=sync.crux.garden
# S3 bucket for published static content (separate from attachments)
AWS_S3_PUBLISHED_BUCKET=publish.crux.garden
# CloudFront distribution ID for cache invalidation on publish (optional)
AWS_CLOUDFRONT_DISTRIBUTION_ID=<key>


# Publish v2 (ADR 0011) — a bucket per published crux behind CloudFront
# 'shared' keeps the legacy single-bucket layout until the origin router is deployed
PUBLISH_LAYOUT=shared
# Enable only after the revision-aware standard origin router and API tenant activation are deployed.
# Until enabled, publish returns 503 before writing; existing publications remain readable.
PUBLISH_REVISION_ROUTING=0
PUBLISH_BUCKET_PREFIX=crux-
# Long random secret; CloudFront sends it as Referer, bucket policies require it
PUBLISH_ORIGIN_SECRET=<random-48-chars>
# Bandwidth metering: CloudFront standard logs bucket (+ optional prefix)
AWS_CLOUDFRONT_LOG_BUCKET=logs.publish.crux.garden
AWS_CLOUDFRONT_LOG_PREFIX=
# Custom domains: the publish distribution, its connection group, the hostname→crux table,
# and the CNAME target users point their domain at
PUBLISH_DISTRIBUTION_ID=<distribution-id>
# Multi-tenant distribution custom-domain tenants attach to (infra/scripts/05); origin {{bucket}}.s3-website-…
PUBLISH_TENANT_DISTRIBUTION_ID=
# The gatepost's fixed addresses (infra/gatepost): a bare custom domain points its A/AAAA here and is
# redirected to www. Comma-separated, v4 and v6. Empty → bare domains are asked for an ALIAS instead.
APEX_REDIRECT_IPS=
PUBLISH_CONNECTION_GROUP_ID=
PUBLISH_CNAME_TARGET=publish.crux.garden

# Explicit persistent local simulator (same API database, synthetic prices, no payments/emails).
# BILLING_PROVIDER=simulation
# Production simulation additionally requires BILLING_ALLOW_MOCK=1. Use a separate database.
# Billing (ADR 0012) — Stripe. Unset → MOCK mode (checkouts succeed instantly; dev/nursery only)
STRIPE_SECRET_KEY=<sk_live_or_test>
STRIPE_WEBHOOK_SECRET=<whsec_...>
# Price ids from the Stripe dashboard (monthly + yearly per paid plan)
STRIPE_PRICE_GARDENER_MONTHLY=<price_...>
STRIPE_PRICE_GARDENER_YEARLY=<price_...>
# 0 = pay up front; e.g. 14 = card-free trial, Stripe collects a card before it ends
STRIPE_TRIAL_DAYS=0
# Stripe Tax calculation on checkout (needs tax settings in the dashboard)
STRIPE_AUTOMATIC_TAX=0
# Where Checkout / the Customer Portal send people back (the web app's /billing/* pages)
BILLING_RETURN_URL=https://crux.garden

# Public API base injected into published pages' crux.store SDK (falls back to API_URL)
PUBLIC_API_URL=https://api.crux.garden
API_URL=https://api.crux.garden
# Nursery demo only: anonymous requests act as Keeper. Production startup refuses true.
NURSERY_MODE=false

# Included collaborator (off until a server provider key is configured).
INCLUDED_INFERENCE_ENABLED=0
INCLUDED_ANTHROPIC_API_KEY=
# Explicit opt-in: the supplied Gardener price IDs belong ONLY to the test account.
STRIPE_USE_GARDENER_TEST_PRICES=0
STRIPE_PRICE_GARDENER_PLUS_MONTHLY=
STRIPE_PRICE_GARDENER_PLUS_YEARLY=

# Optional initial operator account. Ordinary migrations create no administrator.
# Configure deliberately for the seed run, then remove these settings.
# BOOTSTRAP_ADMIN_EMAIL=operator@example.com
# BOOTSTRAP_ADMIN_USERNAME=keeper
# The demo Keeper is created only when NURSERY_MODE=true outside production.

# Billing operational worker: enabled by default for Stripe; mock/simulation never auto-run.
# Use 0 only when an external worker drives reconciliation and notice delivery explicitly.
BILLING_RECONCILIATION=1

# Included subscriber image generation/editing; server-only credential.
# Shares the existing included AI allowance. No automatic paid overages.
INCLUDED_OPENAI_API_KEY=

# Reports of published creations (POST /explore/reports) are emailed here when set.
# Reports are always stored; operators review them at GET /admin/reports.
# REPORTS_NOTIFY_EMAIL=abuse@example.com
# Public website origin used in the sitemap (falls back to BILLING_RETURN_URL, then https://crux.garden)
# PUBLIC_WEB_URL=https://crux.garden
